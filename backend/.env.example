# Server
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/anistrem?retryWrites=true&w=majority

# JWT Secrets (generate strong random strings)
JWT_SECRET=your-super-secret-jwt-key-min-64-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-min-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (your deployed frontend domain)
FRONTEND_URL=https://your-frontend-domain.com

# Admin (used by seed script only — set real values in DB after first login)
ADMIN_EMAIL=admin@anistrem.com
ADMIN_PASSWORD=change-this-password

# Email (Nodemailer — optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=AniStrem <noreply@anistrem.com>

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=524288000
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/ogg,video/quicktime
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# Storage: 'local' | 's3' | 'cloudinary' | 'gcs'
STORAGE_TYPE=local

# AWS S3 (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Cloudinary (if STORAGE_TYPE=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Cloud Storage (if STORAGE_TYPE=gcs)
GCS_PROJECT_ID=
GCS_KEY_FILENAME=
GCS_BUCKET_NAME=

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Socket.io
SOCKET_IO_CORS_ORIGIN=https://your-frontend-domain.com
