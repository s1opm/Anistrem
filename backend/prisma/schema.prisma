generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────── AUTH ────────────────────────────

model Admin {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  email         String   @unique
  password      String
  role          String   @default("admin") // superadmin | admin | editor
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  loginAttempts Int      @default(0)
  lockUntil     DateTime?
  tokenVersion  Int      @default(0)
  refreshToken  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  videos       Video[]       @relation("VideoAddedBy")
  videosPub    Video[]       @relation("VideoPublishedBy")
  videosUpd    Video[]       @relation("VideoUpdatedBy")
  categories   Category[]    @relation("CategoryCreatedBy")
  categoriesUpd Category[]   @relation("CategoryUpdatedBy")
  series       Series[]
  settings     SiteSettings?

  @@index([email])
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  username        String   @unique
  email           String   @unique
  password        String
  avatar          String?
  role            String   @default("user") // user | moderator | admin
  status          String   @default("active") // active | suspended | banned
  emailVerified   Boolean  @default(false)
  lastLogin       DateTime?
  lastLoginIP     String?
  tokenVersion    Int      @default(0)
  refreshToken    String?

  displayName     String?
  bio             String?
  dateOfBirth     DateTime?
  country         String?
  language        String   @default("en")
  timezone        String?

  socialLinks     Json?    @default("{}")

  // Nested stats as columns
  videoCount      Int      @default(0)
  subscriberCount Int      @default(0)
  totalViews      Int      @default(0)
  totalWatchTime  Float    @default(0)

  // Subscription
  subscriptionStatus String @default("free") // free | active | canceled | expired
  subscriptionPlan   String?
  subscriptionExpiry DateTime?
  stripeCustomerId   String?

  blockedUsers    String[] @default([])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  comments        Comment[]
  favorites       Favorite[]
  watchHistory    WatchHistory[]
  playlists       Playlist[]

  @@index([email])
  @@index([username])
}

// ──────────────────────────── CONTENT ────────────────────────────

model Category {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  slug            String   @unique
  description     String?
  icon            String?
  iconColor       String?
  gradient        String?
  thumbnail       String?
  parentId        String?  @db.Uuid
  parent          Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[] @relation("CategoryParent")
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  showOnHomepage  Boolean  @default(false)
  videoCount      Int      @default(0)
  viewCount       Int      @default(0)
  metaTitle       String?
  metaDescription String?
  keywords        String[]
  createdByAdminId String? @db.Uuid
  createdBy       Admin?   @relation("CategoryCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  updatedByAdminId String? @db.Uuid
  updatedBy       Admin?   @relation("CategoryUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  videos          Video[]
  series          Series[]
  favorites       Favorite[]
  playlists       Playlist[]

  @@index([slug])
  @@index([isActive, order])
  @@index([parentId])
}

model Video {
  id              String   @id @default(uuid()) @db.Uuid
  title           String
  slug            String   @unique
  description     String?
  tags            String[] @default([])
  status          String   @default("draft") // draft | processing | published | failed | archived
  visibility      String   @default("public") // public | private | unlisted

  // Video file
  videoUrl        String?
  videoSize       Float?
  videoFormat     String?
  videoDuration   Float?
  videoWidth      Int?
  videoHeight     Int?
  videoBitrate    String?
  videoCodec      String?
  videoFps        Float?

  // Qualities
  qualities       Json?    @default("[]")

  // Thumbnails
  thumbnail       String?
  thumbnails      String[] @default([])
  previewVideo    String?
  sprite          String?

  // Season/Episode
  seasonNumber    Int?
  episodeNumber   Int?
  seriesId        String?  @db.Uuid
  seriesTitle     String?

  // Counts
  viewCount       Int      @default(0)
  likeCount       Int      @default(0)
  dislikeCount    Int      @default(0)
  commentCount    Int      @default(0)
  shareCount      Int      @default(0)
  favoriteCount   Int      @default(0)
  averageWatchTime Float?

  // SEO
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?

  // Category
  categoryId      String   @db.Uuid
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Processing
  processingStatus String?
  processingError  String?
  jobId           String?

  // Publishing
  publishedAt     DateTime?
  scheduledAt     DateTime?
  expiresAt       DateTime?
  isFeatured      Boolean  @default(false)

  // Admin refs
  addedByAdminId  String?  @db.Uuid
  addedBy         Admin?   @relation("VideoAddedBy", fields: [addedByAdminId], references: [id], onDelete: SetNull)
  updatedByAdminId String? @db.Uuid
  updatedBy       Admin?   @relation("VideoUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  publishedByAdminId String? @db.Uuid
  publishedBy     Admin?   @relation("VideoPublishedBy", fields: [publishedByAdminId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  comments        Comment[]
  favorites       Favorite[]
  watchHistory    WatchHistory[]
  videoViews      VideoView[]
  playlistVideos  PlaylistVideo[]

  @@index([slug])
  @@index([categoryId])
  @@index([status, visibility])
  @@index([isFeatured])
  @@index([publishedAt])
  @@index([viewCount(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model Series {
  id              String   @id @default(uuid()) @db.Uuid
  title           String
  slug            String   @unique
  description     String?
  tags            String[] @default([])
  thumbnail       String?
  banner          String?
  status          String   @default("draft") // draft | ongoing | completed | paused
  visibility      String   @default("public")
  releaseYear     Int?
  endYear         Int?
  ageRating       String?
  language        String?  @default("ja")
  studio          String?
  genres          String[] @default([])

  // Counts
  viewCount       Int      @default(0)
  likeCount       Int      @default(0)
  dislikeCount    Int      @default(0)
  favoriteCount   Int      @default(0)

  // Rating
  averageRating   Float    @default(0)
  ratingCount     Int      @default(0)

  // Cast
  cast            Json?    @default("[]")
  crew            Json?    @default("[]")

  // SEO
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?

  // Category
  categoryId      String?  @db.Uuid
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Admin
  createdByAdminId String? @db.Uuid
  createdBy       Admin?   @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seasons         Season[]

  @@index([slug])
  @@index([categoryId])
  @@index([status, visibility])
}

model Season {
  id              String   @id @default(uuid()) @db.Uuid
  seriesId        String   @db.Uuid
  series          Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seasonNumber    Int
  title           String?
  description     String?
  thumbnail       String?
  banner          String?
  episodeCount    Int      @default(0)
  totalDuration   Float    @default(0)
  viewCount       Int      @default(0)
  releaseDate     DateTime?
  endDate         DateTime?
  status          String   @default("draft")
  isReleased      Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([seriesId, seasonNumber])
  @@index([seriesId])
}

// ──────────────────────────── INTERACTIONS ────────────────────────────

model Comment {
  id              String   @id @default(uuid()) @db.Uuid
  videoId         String   @db.Uuid
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId          String?  @db.Uuid
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentCommentId String?  @db.Uuid
  parentComment   Comment? @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentReplies")
  content         String
  mentions        String[] @default([])
  likeCount       Int      @default(0)
  dislikeCount    Int      @default(0)
  replyCount      Int      @default(0)
  isEdited        Boolean  @default(false)
  isPinned        Boolean  @default(false)
  isHighlighted   Boolean  @default(false)
  status          String   @default("active") // active | pending | rejected | deleted | spam
  moderatedBy     String?
  moderatedAt     DateTime?
  moderationNote  String?
  ip              String?
  userAgent       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([videoId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([parentCommentId])
  @@index([status])
}

model Favorite {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId     String?  @db.Uuid
  video       Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  categoryId  String?  @db.Uuid
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  notes       String?
  tags        String[] @default([])
  isPrivate   Boolean  @default(false)
  watched     Boolean  @default(false)
  watchedAt   DateTime?
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
}

model WatchHistory {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId           String   @db.Uuid
  video             Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  progress          Float    @default(0) // current time in seconds
  duration          Float    @default(0)
  watchedPercentage Float    @default(0)
  completed         Boolean  @default(false)
  quality           String?
  device            String?
  ip                String?
  userAgent         String?
  sessionId         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([videoId])
}

model VideoView {
  id                String   @id @default(uuid()) @db.Uuid
  videoId           String   @db.Uuid
  video             Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId            String?  @db.Uuid
  sessionId         String?
  ip                String?
  country           String?
  region            String?
  city              String?
  device            String?
  os                String?
  browser           String?
  referrer          String?
  startTime         DateTime?
  endTime           DateTime?
  duration          Float?
  videoDuration     Float?
  watchedPercentage Float?
  quality           String?
  isComplete        Boolean  @default(false)
  isUnique          Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@index([videoId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([sessionId])
}

model Playlist {
  id              String   @id @default(uuid()) @db.Uuid
  title           String
  slug            String   @unique
  description     String?
  userId          String   @db.Uuid
  categoryId      String?  @db.Uuid
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags            String[] @default([])
  status          String   @default("public") // public | private
  visibility      String   @default("public") // public | private | unlisted
  isFeatured      Boolean  @default(false)
  isCollaborative Boolean  @default(false)
  thumbnail       String?
  totalDuration   Float    @default(0)
  videoCount      Int      @default(0)
  viewCount       Int      @default(0)
  likeCount       Int      @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos          PlaylistVideo[]

  @@index([userId])
  @@index([slug])
}

model PlaylistVideo {
  id          String   @id @default(uuid()) @db.Uuid
  playlistId  String   @db.Uuid
  playlist    Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  videoId     String   @db.Uuid
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  order       Int      @default(0)
  addedByUserId String? @db.Uuid
  createdAt   DateTime @default(now())

  @@unique([playlistId, videoId])
  @@index([playlistId])
  @@index([videoId])
}

// ──────────────────────────── SETTINGS ────────────────────────────

model SiteSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  key                String   @unique
  value              Json
  adminId            String?  @unique @db.Uuid
  admin              Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([key])
}
